      "mass_kg": 30.0,
      "examples": ["ANYmal B", "Spot", "MIT Cheetah 3"],
      "defaults": {
        "mass_range": [-5.0, 5.0],
        "friction_range": [0.3, 1.2],
        "motor_stiffness_range": [0.8, 1.2],
        "motor_damping_range": [0.8, 1.2],
        "joint_damping_range": [0.0, 1.0],
        "joint_friction_range": [0.0, 0.1],
        "external_force_range": [0.0, 15.0],
