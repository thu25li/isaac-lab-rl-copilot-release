        "obs_noise_joint_vel": 0.05
      }
    },
    "quadruped_medium": {
      "description": "中型四足（Unitree Go2, ANYmal D, MIT Mini Cheetah）",
      "mass_kg": 15.0,
      "examples": ["Unitree Go2", "ANYmal D", "MIT Mini Cheetah"],
      "defaults": {
        "mass_range": [-3.0, 3.0],
        "friction_range": [0.3, 1.2],
        "motor_stiffness_range": [0.8, 1.2],
        "motor_damping_range": [0.8, 1.2],
        "joint_damping_range": [0.0, 0.7],
        "joint_friction_range": [0.0, 0.08],
        "external_force_range": [0.0, 8.0],
        "com_offset_range": [-0.05, 0.05],
        "added_payload_range": [0.0, 2.0],
        "obs_noise_lin_vel": 0.05,
        "obs_noise_ang_vel": 0.05,
        "obs_noise_joint_pos": 0.01,
        "obs_noise_joint_vel": 0.05
      }
    },
    "biped_small": {
      "description": "小型双足（Cassie, Digit Mini）",
      "mass_kg": 15.0,
      "examples": ["Cassie", "Digit"],
      "defaults": {
        "mass_range": [-1.0, 1.0],
        "friction_range": [0.4, 1.0],
        "motor_stiffness_range": [0.85, 1.15],
        "motor_damping_range": [0.85, 1.15],
        "joint_damping_range": [0.0, 0.3],
        "joint_friction_range": [0.0, 0.03],
        "external_force_range": [0.0, 3.0],
        "obs_noise_lin_vel": 0.05,
        "obs_noise_ang_vel": 0.05,
        "obs_noise_joint_pos": 0.01,
        "obs_noise_joint_vel": 0.05
      }
    },
    "manipulator_arm": {
      "description": "机械臂（UR5e, Franka Panda, KUKA）",
      "mass_kg": 5.0,
      "examples": ["UR5e", "Franka Panda", "KUKA iiwa"],
      "defaults": {
        "mass_range": [-0.5, 0.5],
        "friction_range": [0.5, 1.0],
        "motor_stiffness_range": [0.9, 1.1],
        "motor_damping_range": [0.9, 1.1],
        "joint_damping_range": [0.0, 0.2],
        "joint_friction_range": [0.0, 0.02],
        "external_force_range": [0.0, 2.0],
        "obs_noise_lin_vel": 0.02,
