# DeepSeek API credentials
# Get yours at https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-key-here

# Model selection
# - deepseek-chat (currently resolves to V4-flash, cheap) — recommended for dev
# - deepseek-reasoner (R1, expensive ~10x, smarter reasoning) — use for production
DEEPSEEK_MODEL=deepseek-chat

# Agent server auth (the credential you'll fill into 清小搭向导)
# Generate any non-empty string; this is what clients must send as Bearer token
AGENT_API_KEY=sk-isaac-lab-rl-copilot-local
# ⚠️ 上为本地开发示例值——生产部署请换成强随机串（如 openssl rand -hex 24 生成）

# Server config
HOST=0.0.0.0
PORT=8765

# PUBLIC_BASE_URL — the public-facing URL 清小搭 will use to fetch attachment files.
# reward_synthesizer writes reward code to logs/files/<uuid>.py and the attachment
# fileUrl is built as ${PUBLIC_BASE_URL}/files/<uuid>.py. 清小搭 server fetches this URL.
# - Local dev (only your own machine can reach): http://localhost:8765
# - Public: https://your-ngrok-or-cloudflare-domain.io (NO trailing slash)
PUBLIC_BASE_URL=http://localhost:8765

# Base path to the skill root (the parent dir, containing scripts/ resources/ etc.)
# Defaults to ".." relative to agent_server/
SKILL_ROOT=..
